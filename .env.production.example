# Road to Success: production environment. Copy to .env.production next to
# docker-compose.prod.yml, fill in every value, and keep it out of git
# (.gitignore already covers .env*). See DEPLOY.md.

# ---------------------------------------------------------------------------
# Required. The container runs scripts/check-env.mjs before anything else and
# refuses to start if any of these four is missing or malformed.
# ---------------------------------------------------------------------------

# Postgres. With the bundled db service the host is the service name, `db`.
# The user, password and database here must match the POSTGRES_* values below.
DATABASE_URL=postgresql://rts:CHANGE_ME_DB_PASSWORD@db:5432/rts

# A long random string. Generate it with:
#   openssl rand -base64 48
# Note, honestly: no code path reads this today. Sessions are 256-bit random
# tokens stored as SHA-256 hashes (lib/auth.ts), so there is nothing to sign.
# It is required up front so that the day something does need signing, nobody
# has to introduce a secret on a live box and invalidate everyone's session.
# Treat it as a real secret anyway: never commit it, never reuse it.
AUTH_SECRET=

# The public origin, exactly as students will type it. Must match DOMAIN below.
APP_URL=https://rts.example.com

# The tutor's timezone. Every release day is 09:00 here, and every date on
# every screen is rendered here, because the server runs UTC.
APP_TIMEZONE=Europe/Athens

# ---------------------------------------------------------------------------
# Only the bundled db and caddy services read these. If DATABASE_URL points at
# managed Postgres, delete the POSTGRES_* lines and drop the db service.
# ---------------------------------------------------------------------------

POSTGRES_USER=rts
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=rts

# The certificate Caddy asks for. Must be the host part of APP_URL.
DOMAIN=rts.example.com
