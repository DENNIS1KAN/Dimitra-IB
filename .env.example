# All variables are OPTIONAL in dev (SPEC §9): with none set, the app uses
# an embedded Postgres (PGlite, persisted in ./pgdata-lite), prints magic
# links to the server console, and stores files in ./storage.

# Postgres connection string.
DATABASE_URL=postgresql://postgres:lumen_dev@localhost:5432/lumen

# Public origin used in magic links.
APP_URL=http://localhost:3000

# The tutor's timezone: release-date inputs and every displayed date use it
# (servers run UTC). IANA name.
APP_TIMEZONE=Europe/Athens

# Secret for signing (any long random string). Required in production.
AUTH_SECRET=

# --- Email (M3+; unset = links print to the console) ---
RESEND_API_KEY=
EMAIL_FROM="Lumen <hello@example.com>"

# --- Bunny Stream (M3+; unset = local video playback from ./storage) ---
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=

# --- Bunny Storage (M3+; unset = ./storage folder) ---
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_REGION=
