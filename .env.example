# All variables are OPTIONAL in dev (SPEC §9): with none set, the app uses
# an embedded Postgres (PGlite, persisted in ./pgdata-lite) and stores
# files in ./storage. Sign-in is username + password (see the seed output
# for dev credentials).

# Postgres connection string.
DATABASE_URL=postgresql://postgres:lumen_dev@localhost:5432/lumen

# Public origin of the deployed app.
APP_URL=http://localhost:3000

# The tutor's timezone: release-date inputs and every displayed date use it
# (servers run UTC). IANA name.
APP_TIMEZONE=Europe/Athens

# Secret for signing (any long random string). Required in production.
AUTH_SECRET=

# Video and file hosting need no keys at all (SPEC §15.7 #25): uploads live on
# this server's disk under ./storage and are served to signed-in students
# through /api/materials. Size the disk for the course and back ./storage up
# alongside Postgres. A video the tutor already hosts elsewhere can be pasted
# as a link per video instead, from the week editor.
